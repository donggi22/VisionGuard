# 카메라 설정
CAMERA_INDEX=0
CAMERA_URL=rtsp://id:password@privateIP:554/stream2
FPS=15
FRAME_WIDTH=640
FRAME_HEIGHT=360

# 모션 감지
MOTION_THRESHOLD=8000
MOTION_MIN_FRAMES=5

# YOLO
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.4
# .pt 모델은 imgsz를 자유롭게 바꿔도 되지만, OpenVINO로 export한 모델을 쓸 경우
# export 시점 크기와 반드시 일치시켜야 함 (다르면 추론 시 크래시)
YOLO_IMGSZ=320

# 알림 대상 클래스 (COCO 클래스명, 쉼표 구분)
ALERT_CLASSES=person,car,cat,dog

# 녹화
PRE_RECORD_SECONDS=10
POST_RECORD_SECONDS=10

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# 알림 쿨타임 (초)
ALERT_COOLDOWN_SECONDS=30

# YOLO 사후 검증: 트리거 기준 앞뒤 각각 몇 초, 총 몇 프레임 샘플링할지
VERIFY_WINDOW_SECONDS=1.0
VERIFY_SAMPLE_COUNT=6

# 저장 보존 기간 (일) — 영구 보관으로 변경하여 비활성화
# RETENTION_DAYS=365 # 일년

# 웹 서버
WEB_HOST=0.0.0.0
WEB_PORT=8080

# 로그인
LOGIN_USERNAME=admin
LOGIN_PASSWORD=changeme
SESSION_SECRET=replace-this-with-a-long-random-string
